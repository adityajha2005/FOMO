VITE_API_BASE_URL=
VITE_DEFAULT_TOKEN=PONS

# Set to true when ready to connect live FOMO/Binance/bot APIs. false = mock data only.
VITE_LIVE_API=false

# API responses are cached for 1 hour in sessionStorage before revalidation.

# Official fomo.family session — required for clan leaderboard (prod-api).
# Prefer FOMO_REFRESH_TOKEN (long-lived); Vite auto-refreshes the bearer JWT.
# DevTools → Application → Local Storage → fomo.family → privy refresh token.
FOMO_REFRESH_TOKEN=

# Optional fallback bearer JWT (~1 hour). Copied from Network → authorization header.
FOMO_TOKEN=

# FOMO API key from https://fomoapi.io/dashboard (free tier: 500 credits/month)
# Unlocks trader leaderboard, alerts, token holders, stats, thesis, WebSocket feed
FOMO_API_KEY=
