VITE_API_BASE_URL=
VITE_DEFAULT_TOKEN=PONS

# Set to true for local dev with live APIs. Vercel/production defaults to live if unset.
VITE_LIVE_API=true

# API responses are cached in sessionStorage before revalidation.

# --- Vercel (Project → Settings → Environment Variables) ---
# VITE_LIVE_API=true          # optional; production defaults to live
# FOMO_API_KEY=               # required for Tokens tab, holders, stats, thesis

# Clan leaderboard comes from fomoapi.io (trader board aggregation). No extra token needed.
# Optional — only if prod-api.fomo.family accepts your session (often blocked outside browser):
# FOMO_REFRESH_TOKEN=   # DevTools → Application → Local Storage → fomo.family
# FOMO_TOKEN=           # DevTools → Network → authorization header on clans/leaderboard

# FOMO API key from https://fomoapi.io/dashboard (free tier: 500 credits/month)
# Unlocks trader leaderboard, alerts, token holders, stats, thesis, WebSocket feed
FOMO_API_KEY=
